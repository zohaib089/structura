{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-webview",
    "src/**/*.test.ts",
    "src/test-support/**",
    "../test-fixtures",
    "../../test-fixtures",
    "**/golden-corpus/**"
  ]
}
