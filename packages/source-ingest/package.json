{
  "name": "@atlasmith/source-ingest",
  "version": "0.1.0",
  "description": "Safe git and archive ingestion for repository scans.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "license": "ISC",
  "dependencies": {
    "tar": "^7.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/tar": "^6.1.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
