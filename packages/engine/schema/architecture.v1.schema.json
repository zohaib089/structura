{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-graph:schema:architecture:1",
  "title": "declared architecture config",
  "type": "object",
  "properties": {
    "architecture": {
      "type": "object",
      "properties": {
        "defaultPolicy": {
          "type": "string",
          "enum": [
            "deny-undeclared",
            "allow-undeclared"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 1
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "policy": {
                "type": "string",
                "enum": [
                  "deny-undeclared",
                  "allow-undeclared"
                ]
              }
            },
            "required": [
              "name",
              "paths"
            ],
            "additionalProperties": false
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 1
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "policy": {
                "type": "string",
                "enum": [
                  "deny-undeclared",
                  "allow-undeclared"
                ]
              }
            },
            "required": [
              "name",
              "paths"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "architecture"
  ],
  "additionalProperties": true
}
