{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "../test-fixtures",
    "../../test-fixtures",
    "**/golden-corpus/**"
  ]
}