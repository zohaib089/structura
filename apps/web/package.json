{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "build": "vue-tsc -b && vite build",
    "build:viewer": "vue-tsc -b && vite build --config vite.viewer.config.ts",
    "build:pages": "VITE_BASE=${PAGES_LANDING_BASE:-/structura/} npm run build && VITE_BASE=${PAGES_VIEWER_BASE:-/structura/viewer/} VITE_VIEWER_BOOT_SAMPLE=true npm run build:viewer && node tools/assemble-pages-site.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test:e2e": "playwright test",
    "test": "npm run test:typecheck && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "@lucide/vue": "^1.60.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "consola": "^3.4.2",
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  }
}
