{
  "name": "api",
  "version": "1.0.0",
  "description": "Structura backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "npm --prefix ../../packages/engine run build && npm --prefix ../../packages/source-ingest run build && npm --prefix ../../packages/scan-analysis run build",
    "start": "node dist/index.js",
    "pretest": "npm --prefix ../../packages/engine run build && npm --prefix ../../packages/source-ingest run build && npm --prefix ../../packages/scan-analysis run build",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "structura",
    "api",
    "fastify"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@atlasmith/engine": "file:../../packages/engine",
    "@atlasmith/scan-analysis": "file:../../packages/scan-analysis",
    "@atlasmith/source-ingest": "file:../../packages/source-ingest",
    "@fastify/multipart": "^9.4.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
